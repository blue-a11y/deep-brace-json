{
  "semi": true,
  "singleQuote": true,
  "arrowParens": "avoid",
  "printWidth": 100,
  "trailingComma": "all",
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["^react$", "^react-dom$", "<THIRD_PARTY_MODULES>", "^\\.\\./", "^\\./"],
  "importOrderParserPlugins": ["typescript", "jsx"]
}
